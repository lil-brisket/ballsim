{
  "name": "ballsim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/vitest.mjs run --project unit --project integration --project react",
    "test:unit": "node scripts/vitest.mjs run --project unit",
    "test:integration": "node scripts/vitest.mjs run --project integration",
    "test:slow": "node scripts/vitest.mjs run --project slow",
    "test:regression": "node scripts/vitest.mjs run --project regression",
    "test:simulation": "node scripts/vitest.mjs run --project simulation",
    "test:all": "node scripts/vitest.mjs run",
    "sim": "tsx scripts/sim.ts",
    "sim:compare": "tsx scripts/sim-compare-manifests.ts",
    "sim:replay": "tsx scripts/sim-replay.ts",
    "lab": "tsx scripts/open-sim-lab.ts",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage --project unit --project integration --project react",
    "bench:sim": "tsx scripts/benchmark-simulation.ts",
    "bench:sim:game": "tsx scripts/benchmark-simulation.ts --game-only",
    "bench:sim:season": "tsx scripts/benchmark-simulation.ts --season",
    "sanity:league": "tsx scripts/league-sanity-report.ts",
    "sanity:compare": "tsx scripts/league-sanity-compare.ts",
    "generate:league-history": "tsx scripts/generate-league-history.ts",
    "playtest:metrics": "tsx scripts/playtest-metrics.ts",
    "portraits:backfill": "tsx --conditions=react-server scripts/backfill-player-portraits.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
