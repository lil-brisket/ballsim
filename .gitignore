# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results.txt
/test-results.last-failure.txt

# Simulation Lab run artifacts
/results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# sqlite
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Ad-hoc analysis reports (analyze-player-*.ts)
/reports
# Scratch output at the repo root
/tmp-*
# Local scratch scripts and their output (never committed)
/scripts/_*

# Personal roster/content files with real-world names; never commit (game is fully fictional)
/local-content

# Agent skills: .agents/skills is the source of truth (skills-lock.json); these are local mirrors
/.claude/skills
/.windsurf/skills

# Generated player portrait overlays (presentation cache, not GameState)
/portraits/
# Temporary worktrees from scripts/generate-golden-saves.ts
/.golden-worktrees/
