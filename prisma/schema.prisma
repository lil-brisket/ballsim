// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Persistence envelope for one save. Game mechanics live in GameState JSON, not Prisma relations.
/// The GameState snapshot is `stateGzip` (gzip of the JSON) when present,
/// else the legacy `stateJson`. `teams` / `players` are query projections.
model SaveGame {
  id            String         @id
  name          String
  schemaVersion Int
  /// Legacy uncompressed snapshot; "" once the save is written compressed.
  stateJson     String
  /// gzip of the GameState JSON. Authoritative when present.
  stateGzip     Bytes?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  teams         SaveTeam[]
  players       SavePlayer[]
  invites       LeagueInvite[]

  @@index([name])
  @@index([updatedAt])
}

/// Online play account. Username is stored lowercase and is the login name.
model User {
  id           String    @id
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

/// Database session. `id` is the SHA-256 of the cookie token, never the token.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Invite link for an online league. `tokenHash` is the SHA-256 of the link token.
/// League membership itself lives in GameState (participant.userId) so it
/// changes atomically with team ownership.
model LeagueInvite {
  id              String    @id
  saveGameId      String
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  maxUses         Int
  uses            Int       @default(0)
  createdAt       DateTime  @default(now())
  saveGame        SaveGame  @relation(fields: [saveGameId], references: [id], onDelete: Cascade)

  @@index([saveGameId])
}

/// Query projection of a domain Team for one save. Not the domain entity.
model SaveTeam {
  saveGameId   String
  teamId       String
  name         String
  city         String
  abbreviation String
  conferenceId String
  divisionId   String
  arenaId      String
  reputation   Int
  saveGame     SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)

  @@id([saveGameId, teamId])
  @@index([saveGameId, conferenceId])
  @@index([saveGameId, name])
}

/// Query projection of a domain Player for one save. Not the domain entity.
model SavePlayer {
  saveGameId       String
  playerId         String
  /// Domain Team.id; null for free agents. Not a Prisma FK (replace-all writes).
  teamId           String?
  firstName        String
  lastName         String
  position         String
  age              Int
  overall          Int
  potentialOverall Int
  availability     String
  retired          Boolean  @default(false)
  saveGame         SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)

  @@id([saveGameId, playerId])
  @@index([saveGameId, teamId])
  @@index([saveGameId, lastName, firstName])
  @@index([saveGameId, position])
}

/// Local custom roster / draft-class package library. Not player authority.
model CustomContentPackage {
  id            String   @id @default(uuid())
  contentId     String   @unique
  type          String
  title         String
  description   String?
  author        String?
  formatVersion Int
  payloadJson   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  published     Boolean  @default(false)
  downloadCount Int      @default(0)
  voteCount     Int      @default(0)
}
